// src/templates/partials/password-reset.pug
.email-reset-content
  h2.email-title Reset Your Password
  
  p.email-greeting Hello #{username || 'User'},
  
  p.email-message 
    | You recently requested to reset your password for your #{companyName} account. 
    | Click the button below to reset it.
  
  .reset-box
    .reset-header
      h3.reset-title Password Reset Request
    
    .reset-body
      p.reset-text
        | Click the button below to reset your password:
      
      .reset-button-container
        a.reset-button(href=validationUrl, target="_blank") 
          span.button-text Reset Password
      
      p.reset-expiry
        | This password reset link will expire in 1 hour.
    
    .reset-footer
      p.reset-alternative
        | Or copy and paste this link in your browser:
        br
        a.reset-link(href=validationUrl, target="_blank") #{validationUrl}
  
  .security-note
    h4.security-title Important Security Information
    p.security-text
      | If you did not request a password reset, please ignore this email or 
      | secure your account immediately. This link can only be used once.
  
  .help-section
    p.help-text
      | For security reasons, this link will expire in 1 hour.
    
    p.help-contact
      | Having trouble? Reply to this email or visit our 
      a(href=supportUrl) Help Center
      | .

style.
  .email-reset-content {
    color: #333333;
    line-height: 1.6;
  }
  
  .email-title {
    color: #d32f2f;
    font-size: 28px;
    margin-bottom: 20px;
    border-bottom: 2px solid #d32f2f;
    padding-bottom: 10px;
  }
  
  .email-greeting {
    font-size: 18px;
    margin-bottom: 20px;
    color: #2c3e50;
  }
  
  .email-message {
    font-size: 16px;
    margin-bottom: 30px;
    color: #555555;
  }
  
  .reset-box {
    background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
    border-radius: 10px;
    padding: 25px;
    margin: 25px 0;
    border-left: 5px solid #d32f2f;
  }
  
  .reset-title {
    color: #b71c1c;
    margin: 0;
    font-size: 22px;
  }
  
  .reset-text {
    font-size: 16px;
    margin-bottom: 25px;
    color: #555555;
  }
  
  .reset-button-container {
    text-align: center;
    margin: 25px 0;
  }
  
  .reset-button {
    display: inline-block;
    background: linear-gradient(135deg, #d32f2f 0%, #b71c1c 100%);
    color: white;
    padding: 15px 35px;
    text-decoration: none;
    border-radius: 50px;
    font-weight: bold;
    font-size: 16px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(211, 47, 47, 0.3);
  }
  
  .reset-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(211, 47, 47, 0.4);
    background: linear-gradient(135deg, #c62828 0%, #8b0000 100%);
  }
  
  .reset-expiry {
    font-size: 14px;
    color: #666666;
    text-align: center;
    margin-top: 15px;
    font-style: italic;
    font-weight: bold;
  }
  
  .reset-footer {
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px dashed #cccccc;
  }
  
  .reset-alternative {
    font-size: 14px;
    color: #666666;
    line-height: 1.5;
  }
  
  .reset-link {
    color: #d32f2f;
    word-break: break-all;
    text-decoration: none;
    font-weight: bold;
  }
  
  .reset-link:hover {
    text-decoration: underline;
  }
  
  .security-note {
    background-color: #fff3e0;
    border-radius: 8px;
    padding: 20px;
    margin: 25px 0;
    border-left: 5px solid #ff9800;
  }
  
  .security-title {
    color: #e65100;
    margin-top: 0;
    font-size: 18px;
  }
  
  .security-text {
    color: #5d4037;
    font-size: 14px;
    margin: 0;
  }
  
  .help-section {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #eeeeee;
  }
  
  .help-text {
    color: #d32f2f;
    font-size: 14px;
    margin-bottom: 15px;
    font-weight: bold;
  }
  
  .help-contact {
    color: #666666;
    font-size: 14px;
  }
  
  .help-contact a {
    color: #d32f2f;
    text-decoration: none;
    font-weight: bold;
  }
  
  .help-contact a:hover {
    text-decoration: underline;
  }
  
  /* Additional warning box */
  .warning-box {
    background-color: #fff8e1;
    border: 2px solid #ffd54f;
    border-radius: 8px;
    padding: 15px;
    margin: 20px 0;
  }
  
  .warning-title {
    color: #ff8f00;
    margin-top: 0;
    font-size: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .warning-title:before {
    content: "⚠️";
  }
  
  .warning-text {
    color: #5d4037;
    font-size: 14px;
    margin: 0;
  }
  
  @media (max-width: 600px) {
    .reset-box {
      padding: 20px;
    }
    
    .email-title {
      font-size: 24px;
    }
    
    .reset-button {
      padding: 12px 25px;
      font-size: 14px;
    }
  }